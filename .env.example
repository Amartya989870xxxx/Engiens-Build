# Engiens Build — server-side configuration.
# Copy to `.env` and fill in real values. These keys are only ever read by the
# Express backend; they are never sent to the browser. Do NOT prefix with VITE_.

# Required — TinyFish Search + Fetch (https://agent.tinyfish.ai/api-keys)
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Required — Gemini Primary Provider (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional — Groq Secondary Fallback Provider (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional — backend port (default: 8787)
PORT=8787

# --- GitHub Authentication ---
# Option 1: GitHub App (Priority 1 — supports authorized private repositories)
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=

# Option 2: GitHub Personal Access Token (Priority 2 — fallback for public/private repo token access)
GITHUB_TOKEN=
